{
  "version": 6,
  "configurePresets": [
    {
      "name": "desktop",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop-dev",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "web",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/web-release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "web", "configurePreset": "web" }
  ],
  "workflowPresets": [
    {
      "name": "desktop",
      "steps": [
        { "type": "configure", "name": "desktop" },
        { "type": "build", "name": "desktop" }
      ]
    },
    {
      "name": "web",
      "steps": [
        { "type": "configure", "name": "web" },
        { "type": "build", "name": "web" }
      ]
    }
  ]
}
